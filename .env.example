# İki sağlayıcılı önerilen akış:
# 1) OpenAI: stratejist
# 2) Gemini: eleştirmen / aykırı fikir avcısı
# 3) OpenAI: nihai sentezleyici

STRATEGIST_MODEL=openai/gpt-5.6-luna
STRATEGIST_FALLBACKS=gemini/gemini-2.5-flash

CRITIC_MODEL=gemini/gemini-2.5-flash
CRITIC_FALLBACKS=openai/gpt-5.6-luna

SYNTHESIZER_MODEL=openai/gpt-5.6-luna
SYNTHESIZER_FALLBACKS=gemini/gemini-2.5-flash

REQUEST_TIMEOUT_SECONDS=90
MAX_ATTEMPTS_PER_MODEL=3
MAX_REVISION_ROUNDS=1
MIN_VERDICT_CONFIDENCE=0.78
MAX_UNRESOLVED_QUESTIONS=3
MAX_CRITIC_CONTRADICTIONS=0
MAX_CONTEXT_CHARS=42000
LOG_LEVEL=INFO

OPENAI_API_KEY=
GEMINI_API_KEY=
